#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.config/icloud-linux"
STATE_DIR="$HOME/.local/state/icloud-linux"
CACHE_DIR="$HOME/.cache/icloud-linux"
SERVICE_DIR="$HOME/.config/systemd/user"
CONFIG_FILE="$CONFIG_DIR/config.yaml"
ENV_FILE="$CONFIG_DIR/icloud.env"
SERVICE_FILE="$SERVICE_DIR/icloud.service"
MOUNT_DIR_DEFAULT="$HOME/iCloud"

need_cmd() { command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1"; exit 1; }; }

reject_control_chars() {
  local label="$1"
  local value="$2"
  if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
    echo "$label must not contain newlines"
    exit 1
  fi
}

systemd_quote_arg() {
  local value="$1"
  reject_control_chars "systemd argument" "$value"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//%/%%}
  printf '"%s"' "$value"
}

ensure_dirs() {
  mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$CACHE_DIR" "$SERVICE_DIR"
}

ensure_venv() {
  if [[ ! -x "$REPO_DIR/.venv/bin/python" ]]; then
    echo "Creating virtualenv..."
    python3 -m venv "$REPO_DIR/.venv"
  fi
  "$REPO_DIR/.venv/bin/pip" install -q -r "$REPO_DIR/requirements.txt"
}

create_config_if_missing() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cp "$REPO_DIR/config.example.yaml" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
    echo "Created $CONFIG_FILE"
  fi
}

write_service() {
  local mount_dir="$1"
  local python_bin="$REPO_DIR/.venv/bin/python"
  local driver_py="$REPO_DIR/driver.py"
  local python_bin_q driver_py_q config_file_q mount_dir_q
  python_bin_q="$(systemd_quote_arg "$python_bin")"
  driver_py_q="$(systemd_quote_arg "$driver_py")"
  config_file_q="$(systemd_quote_arg "$CONFIG_FILE")"
  mount_dir_q="$(systemd_quote_arg "$mount_dir")"
  cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=iCloud Linux FUSE filesystem (user)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/fusermount -uz $mount_dir_q
ExecStop=-/usr/bin/fusermount -uz $mount_dir_q
ExecStart=$python_bin_q $driver_py_q -f -c $config_file_q $mount_dir_q
Restart=on-failure
RestartSec=15
TimeoutStopSec=10
KillMode=control-group
ExecStopPost=-/usr/bin/fusermount -uz $mount_dir_q
Environment=ICLOUD_LOG_PATH=%h/.local/state/icloud-linux/icloud.log

[Install]
WantedBy=default.target
EOF
}

write_env() {
  local mount_dir="${1:-$MOUNT_DIR_DEFAULT}"
  mkdir -p "$mount_dir"
  reject_control_chars "mount dir" "$mount_dir"
  {
    printf 'ICLOUD_CONFIG=%q\n' "$CONFIG_FILE"
    printf 'ICLOUD_MOUNT=%q\n' "$mount_dir"
  } > "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

load_env_if_present() {
  if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
  fi
}

config_cache_dir() {
  local configured=""
  if [[ -f "$CONFIG_FILE" ]]; then
    configured="$(sed -nE 's/^[[:space:]]*cache_dir[[:space:]]*:[[:space:]]*"?([^"#]*[^"# ])"?[[:space:]]*$/\1/p' "$CONFIG_FILE" | head -n1)"
  fi
  configured="${configured:-$CACHE_DIR}"
  echo "${configured/#\~/$HOME}"
}

cleanup_mountpoint() {
  load_env_if_present
  local mount_dir="${1:-${ICLOUD_MOUNT:-$MOUNT_DIR_DEFAULT}}"
  mkdir -p "$mount_dir"

  if mountpoint -q "$mount_dir"; then
    echo "Cleaning mounted FUSE endpoint at $mount_dir"
    fusermount -uz "$mount_dir" >/dev/null 2>&1 || fusermount -u "$mount_dir" >/dev/null 2>&1 || true
    sleep 1
  fi

  if [[ -d "$mount_dir" ]] && ! ls "$mount_dir" >/dev/null 2>&1; then
    echo "Cleaning stale FUSE transport endpoint at $mount_dir"
    fusermount -uz "$mount_dir" >/dev/null 2>&1 || true
    sleep 1
  fi
}

cmd_init() {
  local mount_dir="${1:-$MOUNT_DIR_DEFAULT}"
  need_cmd systemctl
  ensure_dirs
  ensure_venv
  create_config_if_missing

  mkdir -p "$mount_dir"
  if [[ ! -w "$mount_dir" ]]; then
    local fallback="$HOME/iCloudDrive"
    mkdir -p "$fallback"
    if [[ -w "$fallback" ]]; then
      echo "Mount dir not writable: $mount_dir"
      echo "Using fallback mount dir: $fallback"
      mount_dir="$fallback"
    else
      echo "Mount dir is not writable: $mount_dir"
      echo "Fix with: sudo chown -R $USER:$USER '$mount_dir'"
      exit 1
    fi
  fi

  write_env "$mount_dir"
  write_service "$mount_dir"
  systemctl --user daemon-reload
  systemctl --user enable icloud.service >/dev/null
  echo "Initialized."
  echo "- Config: $CONFIG_FILE"
  echo "- Env:    $ENV_FILE"
  echo "- Mount:  $mount_dir"
  echo "Next: ./icloudctl auth"
}

cmd_configure() {
  ensure_dirs
  create_config_if_missing
  local email="${1:-}"
  if [[ -z "$email" ]]; then
    read -r -p "Apple ID email: " email
  fi
  read -r -s -p "Apple ID password (input hidden): " password
  echo
  cat > "$CONFIG_FILE" <<EOF
username: "$email"
password: "$password"
cache_dir: "$CACHE_DIR"
crawl_mode: "lazy"
warmup_mode: "background"
conflict_mode: "copy"
upload_interval_seconds: 30
remote_refresh_interval_seconds: 300
warmup_workers: 1
cookie_dir: "$CONFIG_DIR/cookies"
fuse_options:
  allow_other: false
  ro: false
  nonempty: true
EOF
  chmod 600 "$CONFIG_FILE"
  echo "Wrote $CONFIG_FILE"
}

cmd_auth() {
  ensure_venv
  create_config_if_missing
  "$REPO_DIR/.venv/bin/python" "$REPO_DIR/auth.py" "$CONFIG_FILE" "$@"
}

cmd_start() { cleanup_mountpoint "${1:-}"; systemctl --user start icloud.service; systemctl --user --no-pager status icloud.service; }
cmd_stop() { systemctl --user stop icloud.service >/dev/null 2>&1 || true; cleanup_mountpoint "${1:-}"; systemctl --user --no-pager status icloud.service || true; }
cmd_restart() { systemctl --user stop icloud.service >/dev/null 2>&1 || true; cleanup_mountpoint "${1:-}"; systemctl --user start icloud.service; systemctl --user --no-pager status icloud.service; }
cmd_status() { systemctl --user --no-pager status icloud.service; }
cmd_logs() { journalctl --user -u icloud.service -f; }
cmd_hydrate() {
  ensure_venv
  "$REPO_DIR/.venv/bin/python" "$REPO_DIR/hydrate.py" --config "$CONFIG_FILE" "$@"
}

cmd_sync() {
  ensure_venv
  "$REPO_DIR/.venv/bin/python" "$REPO_DIR/sync.py" "$@"
}

cmd_refresh() {
  if ! systemctl --user is-active --quiet icloud.service; then
    echo "icloud.service is not running. Start it with './icloudctl start' first."
    exit 1
  fi
  systemctl --user kill --kill-whom=main --signal=SIGUSR1 icloud.service
  echo "Requested remote metadata crawl. Watch progress with './icloudctl logs'."
}
cmd_clear_cache() {
  local was_active=0
  systemctl --user is-active --quiet icloud.service && was_active=1 || true
  systemctl --user stop icloud.service >/dev/null 2>&1 || true
  rm -rf "$CACHE_DIR"
  mkdir -p "$CACHE_DIR"
  echo "Cleared persistent cache under $CACHE_DIR"
  if [[ "$was_active" -eq 1 ]]; then
    echo "Restarting service to rebuild cache..."
    systemctl --user start icloud.service
    systemctl --user --no-pager status icloud.service
  else
    echo "Service is stopped. Start it with './icloudctl start' to rebuild cache."
  fi
}

NAUTILUS_EXT_DIR="$HOME/.local/share/nautilus-python/extensions"
NAUTILUS_EXT_FILE="$NAUTILUS_EXT_DIR/icloud_status.py"

restart_nautilus() {
  if ! command -v nautilus >/dev/null 2>&1; then
    return
  fi
  echo "Quitting Nautilus so it reloads its extensions (open windows will close)."
  nautilus -q >/dev/null 2>&1 || true
  echo "It starts again on the next file-manager window you open."
}

cmd_nautilus_install() {
  if ! python3 -c "import gi; gi.require_version('Nautilus', '4.0')" >/dev/null 2>&1; then
    echo "WARN: nautilus-python does not look available."
    echo "      Debian/Ubuntu: sudo apt-get install python3-nautilus"
    echo "      Fedora:        sudo dnf install nautilus-python"
  fi
  mkdir -p "$NAUTILUS_EXT_DIR"
  cp "$REPO_DIR/nautilus/icloud_status.py" "$NAUTILUS_EXT_FILE"
  echo "Installed $NAUTILUS_EXT_FILE"
  restart_nautilus
}

cmd_nautilus_uninstall() {
  rm -f "$NAUTILUS_EXT_FILE"
  echo "Removed $NAUTILUS_EXT_FILE"
  restart_nautilus
}

# GNOME's file indexer walks $HOME recursively and opens every file it finds.
# On the mount that reads as a user opening every file, so it hydrates the
# whole drive. driver.py writes the marker into the mirror on startup; this
# command applies it without waiting for a restart and kicks the indexer so it
# picks up the new rule instead of finishing the queue it already built.
cmd_trackerignore() {
  local cache_dir
  cache_dir="$(config_cache_dir)"
  local mirror_root="$cache_dir/mirror"
  if [[ ! -d "$mirror_root" ]]; then
    echo "Mirror not created yet: $mirror_root"
    echo "Start the service once ('./icloudctl start'), then re-run this."
    exit 1
  fi
  if [[ -f "$mirror_root/.trackerignore" ]]; then
    echo "Already excluded from desktop search indexing: $mirror_root/.trackerignore"
    return
  fi
  : > "$mirror_root/.trackerignore"
  echo "Created $mirror_root/.trackerignore"
  if pgrep -u "$USER" -f 'localsearch-3|tracker-miner-fs' >/dev/null 2>&1; then
    pkill -u "$USER" -f 'localsearch-3|tracker-miner-fs' >/dev/null 2>&1 || true
    echo "Restarted the Tracker/localsearch indexer (D-Bus activated; it comes back on demand)."
  fi
}

cmd_uninstall() {
  local purge="${1:-}"
  systemctl --user stop icloud.service >/dev/null 2>&1 || true
  systemctl --user disable icloud.service >/dev/null 2>&1 || true
  rm -f "$SERVICE_FILE"
  systemctl --user daemon-reload
  systemctl --user reset-failed >/dev/null 2>&1 || true

  if [[ "$purge" == "--purge" ]]; then
    rm -f "$CONFIG_FILE" "$ENV_FILE" "$NAUTILUS_EXT_FILE"
    rm -rf "$CONFIG_DIR/cookies" "$CACHE_DIR" "$STATE_DIR"
    echo "Uninstalled and purged local config/cache/session data."
  else
    echo "Uninstalled service. Config/cookies/cache kept."
    echo "Use './icloudctl uninstall --purge' to remove local data too."
  fi
}

cmd_doctor() {
  echo "== icloud-linux doctor =="
  for c in python3 systemctl fusermount; do
    if command -v "$c" >/dev/null 2>&1; then echo "OK: $c"; else echo "MISSING: $c"; fi
  done
  [[ -x "$REPO_DIR/.venv/bin/python" ]] && echo "OK: virtualenv" || echo "MISSING: virtualenv"
  [[ -f "$CONFIG_FILE" ]] && echo "OK: config" || echo "MISSING: $CONFIG_FILE"
  if [[ -f "$ENV_FILE" ]]; then
    echo "OK: env"
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    if [[ -n "${ICLOUD_MOUNT:-}" ]]; then
      [[ -w "$ICLOUD_MOUNT" ]] && echo "OK: mount writable ($ICLOUD_MOUNT)" || echo "WARN: mount not writable ($ICLOUD_MOUNT)"
    fi
  else
    echo "MISSING: $ENV_FILE"
  fi
  systemctl --user --no-pager status icloud.service >/dev/null 2>&1 && echo "OK: service exists" || echo "WARN: service not initialized"

  local mirror_root
  mirror_root="$(config_cache_dir)/mirror"
  if [[ -d "$mirror_root" ]]; then
    if [[ -f "$mirror_root/.trackerignore" ]]; then
      echo "OK: excluded from desktop search indexing"
    else
      echo "WARN: no .trackerignore in $mirror_root — the GNOME indexer may hydrate the whole drive"
      echo "      Fix with: ./icloudctl trackerignore"
    fi
  fi
  [[ -f "$NAUTILUS_EXT_FILE" ]] && echo "OK: Nautilus status extension installed" \
    || echo "INFO: Nautilus status extension not installed (./icloudctl nautilus-install)"
}

cmd_quickstart() {
  local mount_dir="${1:-$MOUNT_DIR_DEFAULT}"
  cmd_init "$mount_dir"
  echo
  echo "Now configure credentials:"
  cmd_configure
  echo
  echo "Authenticate (2FA):"
  cmd_auth
  echo
  echo "Starting service..."
  cmd_start
}

usage() {
  cat <<EOF
Usage: ./icloudctl <command> [args]

Commands:
  quickstart [mount_dir]   One-command guided setup
  init [mount_dir]         Initialize venv/config/service files
  configure [email]        Write config.yaml with credentials
  auth [--force-sms] [--debug] [--trust-token TOKEN]
                           Run interactive 2FA bootstrap.
                           --force-sms bypasses push delivery (iOS 26 beta workaround)
                           --debug prints Apple's reported auth mode for diagnosis
  hydrate [--dry-run] [--verbose]
                           Block until all eligible files are downloaded locally.
                           Honors sync_paths and exclude_paths from config.
                           Use before copy tasks to ensure files are fully local.
  sync [--timeout SEC] [--quiet]
                           Trigger an on-demand remote sync in the running driver
                           (sends SIGUSR1, waits for completion).  Useful when
                           auto_sync: false is set in config.yaml.
  clear-cache              Remove local mirror/state and rebuild on next start
  nautilus-install         Install the Nautilus sidebar status extension
  nautilus-uninstall       Remove the Nautilus status extension
  trackerignore            Exclude the mount from GNOME's search indexer, which
                           would otherwise walk the whole drive and hydrate it
  start|stop|restart       Service control
  refresh                  Refresh remote metadata now.  With crawl_mode: lazy
                           that re-lists every folder already browsed; with
                           crawl_mode: full it is a complete recursive crawl
  status                   Show service status
  logs                     Tail service logs
  doctor                   Check local setup health
  uninstall [--purge]      Remove service (optionally remove local data)
EOF
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    quickstart) cmd_quickstart "$@" ;;
    init) cmd_init "$@" ;;
    configure) cmd_configure "$@" ;;
    auth) cmd_auth "$@" ;;
    hydrate) cmd_hydrate "$@" ;;
    sync) cmd_sync "$@" ;;
    clear-cache) cmd_clear_cache ;;
    nautilus-install) cmd_nautilus_install ;;
    nautilus-uninstall) cmd_nautilus_uninstall ;;
    trackerignore) cmd_trackerignore ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    refresh) cmd_refresh ;;
    status) cmd_status ;;
    logs) cmd_logs ;;
    doctor) cmd_doctor ;;
    uninstall) cmd_uninstall "$@" ;;
    ""|-h|--help|help) usage ;;
    *) echo "Unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
